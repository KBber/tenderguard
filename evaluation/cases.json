{
  "version": "v0.2",
  "description": "TenderGuard evaluation harness (spec §十九). Each case pins one expected outcome that the system must reproduce.",
  "cases": [
    {
      "case_id": "E001",
      "name": "明确 PASS - 项目名称完全一致",
      "tender": "项目名称：智慧校园教学设备采购项目\n项目编号：ZB-2026-001\n包号：001\n",
      "bid": "项目名称：智慧校园教学设备采购项目\n项目编号：ZB-2026-001\n包号：001\n",
      "rule": {"operator": "equals", "fields": ["tender.project_name", "bid.project_name"]},
      "expected_status": "PASS",
      "expected_rule_passed": true
    },
    {
      "case_id": "E002",
      "name": "明确 FAIL - 项目名称不一致",
      "tender": "项目名称：智慧校园教学设备采购项目\n",
      "bid": "项目名称：另一个项目\n",
      "rule": {"operator": "equals", "fields": ["tender.project_name", "bid.project_name"]},
      "expected_status": "FAIL",
      "expected_rule_passed": false
    },
    {
      "case_id": "E003",
      "name": "明确 FAIL - 同型号不同价格（必须 FAIL，不是 REVIEW）",
      "tender": "",
      "bid": "型号 ABC-100 单价 10000 数量 5\n型号 ABC-100 单价 12000 数量 5\n",
      "rule": {"operator": "same_model_same_price", "key": "model", "value": "unit_price"},
      "expected_status": "FAIL",
      "expected_rule_passed": false
    },
    {
      "case_id": "E004",
      "name": "明确 PASS - 小计/合计计算正确",
      "tender": "",
      "bid": "型号 A 单价 100 数量 2\n型号 B 单价 50 数量 4\n合计 400\n",
      "rule": {"operator": "sum_equals", "rows": "bid.price_rows", "total_field": "bid.total_price"},
      "expected_status": "PASS",
      "expected_rule_passed": true
    },
    {
      "case_id": "E005",
      "name": "明确 FAIL - 小计计算错误",
      "tender": "",
      "bid": "型号 A 单价 100 数量 2\n型号 B 单价 50 数量 4\n合计 999\n",
      "rule": {"operator": "sum_equals", "rows": "bid.price_rows", "total_field": "bid.total_price"},
      "expected_status": "FAIL",
      "expected_rule_passed": false
    },
    {
      "case_id": "E006",
      "name": "明确 PASS - 报价不超过限价",
      "tender": "招标限价：100万元\n",
      "bid": "合计 80万元\n",
      "rule": {"operator": "numeric_lte", "actual_field": "bid.total_price", "required_field": "tender.price_ceiling"},
      "expected_status": "PASS",
      "expected_rule_passed": true
    },
    {
      "case_id": "E007",
      "name": "明确 FAIL - 报价超过限价",
      "tender": "招标限价：50万元\n",
      "bid": "合计 80万元\n",
      "rule": {"operator": "numeric_lte", "actual_field": "bid.total_price", "required_field": "tender.price_ceiling"},
      "expected_status": "FAIL",
      "expected_rule_passed": false
    },
    {
      "case_id": "E008",
      "name": "REVIEW_REQUIRED - 抽取失败（限价未识别）",
      "tender": "本次招标无具体限价\n",
      "bid": "合计 100万元\n",
      "rule": {"operator": "numeric_lte", "actual_field": "bid.total_price", "required_field": "tender.price_ceiling"},
      "expected_status": "REVIEW_REQUIRED",
      "expected_rule_passed": null,
      "expected_review_reason": "INSUFFICIENT_EVIDENCE"
    },
    {
      "case_id": "E009",
      "name": "明确 PASS - 资质覆盖达标（rule 通过；evidence 极短会被降级，spec §七）",
      "tender": "检测报告 节能证书 3C 产品彩页\n",
      "bid": "检测报告 节能证书 3C 产品彩页\n",
      "rule": {"operator": "coverage", "source": "tender.product_cert_requirements", "target": "bid.product_certificates", "min_coverage": 0.8},
      "expected_status": "REVIEW_REQUIRED",
      "expected_rule_passed": true,
      "expected_review_reason": "INSUFFICIENT_EVIDENCE"
    },
    {
      "case_id": "E010",
      "name": "明确 FAIL - 资质严重不足",
      "tender": "检测报告 节能证书 3C 产品彩页\n",
      "bid": "检测报告\n",
      "rule": {"operator": "coverage", "source": "tender.product_cert_requirements", "target": "bid.product_certificates", "min_coverage": 0.8},
      "expected_status": "FAIL",
      "expected_rule_passed": false
    },
    {
      "case_id": "E011",
      "name": "明确 PASS - 业绩数量达标",
      "tender": "近三年不少于 3 个类似项目\n",
      "bid": "合同 2024年 500万元\n合同 2023年 600万元\n合同 2022年 700万元\n合同 2021年 800万元\n",
      "rule": {"operator": "count_gte", "rows": "bid.experiences", "count_min": 3},
      "expected_status": "PASS",
      "expected_rule_passed": true
    },
    {
      "case_id": "E012",
      "name": "明确 FAIL - 业绩数量不足",
      "tender": "近三年不少于 3 个类似项目\n",
      "bid": "合同 2024年 500万元\n",
      "rule": {"operator": "count_gte", "rows": "bid.experiences", "count_min": 3},
      "expected_status": "FAIL",
      "expected_rule_passed": false
    },
    {
      "case_id": "E013",
      "name": "明确 PASS - 数字正则",
      "tender": "",
      "bid": "项目编号：ZB-2026-001\n",
      "rule": {"operator": "regex", "field": "bid.project_id", "pattern": "^ZB-\\d{4}-\\d{3}$"},
      "expected_status": "PASS",
      "expected_rule_passed": true
    },
    {
      "case_id": "E014",
      "name": "明确 PASS - 必填字段存在",
      "tender": "",
      "bid": "投标人：北京智教科技股份有限公司\n",
      "rule": {"operator": "required", "field": "bid.bidder_name"},
      "expected_status": "PASS",
      "expected_rule_passed": true
    },
    {
      "case_id": "E015",
      "name": "明确 FAIL - 必填字段为空",
      "tender": "",
      "bid": "项目编号：ZB-2026-001\n",
      "rule": {"operator": "required", "field": "bid.bidder_name"},
      "expected_status": "FAIL",
      "expected_rule_passed": false
    },
    {
      "case_id": "E016",
      "name": "明确 PASS - 字段一致性（pair 等）",
      "tender": "",
      "bid": "法人代表：张三\n",
      "rule": {"operator": "field_consistency", "pairs": [["bid.legal_representative", "authorization.legal_representative"]]},
      "expected_status": "PASS",
      "expected_rule_passed": true
    },
    {
      "case_id": "E017",
      "name": "明确 FAIL - 字段冲突（bid 中法人代表 vs 授权书法人代表不同）",
      "tender": "",
      "bid": "法人代表：张三\n授权书 法人代表：李四 被授权人：王五\n",
      "rule": {"operator": "field_consistency", "pairs": [["bid.legal_representative", "authorization.legal_representative"]]},
      "expected_status": "FAIL",
      "expected_rule_passed": false
    },
    {
      "case_id": "E018",
      "name": "明确 PASS - 文本包含",
      "tender": "",
      "bid": "投标人名称：北京智教科技股份有限公司\n",
      "rule": {"operator": "contains", "field": "bid.bidder_name", "value": "智教"},
      "expected_status": "PASS",
      "expected_rule_passed": true
    },
    {
      "case_id": "E019",
      "name": "明确 PASS - not_contains（关键词不存在）",
      "tender": "",
      "bid": "投标人名称：北京智教科技股份有限公司\n",
      "rule": {"operator": "not_contains", "field": "bid.bidder_name", "value": "竞争对手"},
      "expected_status": "PASS",
      "expected_rule_passed": true
    },
    {
      "case_id": "E020",
      "name": "REVIEW_REQUIRED - 业绩时间字段缺失",
      "tender": "",
      "bid": "",
      "rule": {"operator": "count_gte", "rows": "bid.experiences", "count_min": 1},
      "expected_status": "REVIEW_REQUIRED",
      "expected_rule_passed": null,
      "expected_review_reason": "INSUFFICIENT_EVIDENCE"
    }
  ]
}
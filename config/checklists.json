  {
    "check_id": "AUTH-001",
    "category": "授权",
    "name": "法人代表/被授权人信息",
    "description": "授权文件中的法人代表、被授权人等关键信息应满足招标文件要求并保持一致。",
    "severity": "CRITICAL",
    "verification_method": "hybrid",
    "evidence_required": [

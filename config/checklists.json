[
  {
    "check_id": "CONSIST-001",
    "category": "整体检查",
    "name": "项目名称一致性",
    "description": "标书全文涉及的项目名称应与招标文件一致。",
    "severity": "CRITICAL",
    "verification_method": "rule",
    "evidence_required": [
      "招标文件项目名称",
      "投标文件项目名称"
    ],
    "rule": {
      "operator": "equal",
      "fields": [
        "tender.project_name",
        "bid.project_name"
      ]
    },
    "source_ck": "直投CK/整体检查/一致性检查"
  },
  {
    "check_id": "CONSIST-002",

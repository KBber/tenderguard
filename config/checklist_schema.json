{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TenderGuard Checklist Item",
  "type": "object",
  "required": [
    "check_id",
    "category",
    "name",
    "description",
    "severity",
    "verification_method",
    "evidence_required"
  ],
  "properties": {
    "check_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "verification_method": {
      "enum": [
        "rule",
        "llm",
        "hybrid",
        "human"
      ]
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule": {
      "type": [
        "object",
        "null"
      ],
      "description": "Operator + parameters. For field_consistency, may use either `fields` (all must equal) or `pairs` (each pair checked independently)."
    },
    "source_ck": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}